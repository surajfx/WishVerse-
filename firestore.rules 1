rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared wish links are public to read, but can ONLY be created by the WishVerse server (Cloudflare Worker / createWish) after it verifies payment + usage limit.
    match /wishes/{wishId} {
      // Links live for 10 days: readable only until expiresAt (older wishes: createdAt + 10 days).
      allow read: if resource.data.get('expiresAt', resource.data.createdAt + duration.value(10, 'd')) > request.time;
      allow write: if false;
    }
    // payments, entitlements, users, securityEvents: server-only (the server uses a service account that bypasses rules)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
